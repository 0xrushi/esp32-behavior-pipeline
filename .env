# ESP32 Receiver Configuration

# The Hugging Face model path for SmolVLM
# Default: HuggingFaceTB/SmolVLM2-500M-Instruct
MODEL_PATH=HuggingFaceTB/SmolVLM2-500M-Instruct

# The API webhook URL to send the HTTP POST request to if the person is detected 
# using a phone continuously for over 5 minutes (300 seconds).
ALERT_API_URL=http://example.com/api/alert_endpoint

# The port the Flask application will run on.
PORT=8000
